App(
    appid="ble",
    name="BleSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="ble_srv",
    stack_size=4 * 1024,
    order=100,
    targets=["f64"],
    requires=["intercom"],
    sources=[ "ble.c",
              "service/*.c",
              "service/target/ble_service_target_917.c",
              "service/device_info/*.c",
              "service/battery/*.c",
              "service/uart/*.c",      
            ])

App(
    appid="ble",
    name="BleSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="ble_srv",
    stack_size=2 * 1024,
    order=100,
    targets=["f20"],
    requires=["intercom"],
    sources=["ble.c", 
