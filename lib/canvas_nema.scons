Import("env")
LIB_FOLDER = "canvas_nema"

env.Append(
    CPPPATH=[
        Dir(LIB_FOLDER).srcnode(),
    ],
    LINT_SOURCES=[
        Dir(LIB_FOLDER),
    ],
)


libenv = env.Clone(FW_LIB_NAME=LIB_FOLDER)
libenv.ApplyLibFlags()


cwd = libenv.Dir(".")
libenv.VariantDir(env["BUILD_DIR"].Dir(LIB_FOLDER), Dir(".").srcnode(), duplicate=0)


sources = libenv.GlobRecursive("*.c", Dir(LIB_FOLDER))


lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
