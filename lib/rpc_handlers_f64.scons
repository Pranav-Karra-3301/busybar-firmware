Import("env")

dirname = "rpc_handlers_f64"

env.Append(
    CPPPATH=[
        Dir(f"#/lib/{dirname}").rdir(),
    ],
)

libenv = env.Clone(FW_LIB_NAME=dirname)
libenv.ApplyLibFlags()

sources = libenv.GlobRecursive("*.c", Dir(dirname))

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")

