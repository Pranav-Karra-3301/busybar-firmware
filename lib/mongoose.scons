Import("env")

env.Append(
    CPPPATH=[
        "#/lib/mongoose",
    ],
    CCFLAGS=[
        "-Wno-double-promotion",  # TODO:
    ],
)

libenv = env.Clone(FW_LIB_NAME="mongoose")
libenv.ApplyLibFlags()

sources = [
    "mongoose/src/net.c",
    "mongoose/src/sock.c",
    "mongoose/src/http.c",
    "mongoose/src/ssi.c",
    "mongoose/src/tls_dummy.c",
    "mongoose/src/dns.c",
    "mongoose/src/url.c",
    "mongoose/src/iobuf.c",
    "mongoose/src/event.c",
    "mongoose/src/fs.c",
    "mongoose/src/fs_posix.c",
    "mongoose/src/util.c",
    "mongoose/src/timer.c",
    "mongoose/src/log.c",
    "mongoose/src/printf.c",
    "mongoose/src/fmt.c",
    "mongoose/src/str.c",
    "mongoose/src/json.c",
]

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
